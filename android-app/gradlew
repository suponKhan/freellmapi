##############################################################################
#
#   Gradle start up script for POSIX generated by 'gradle wrapper'.
#
##############################################################################

set -e

# For the debian wrapper script, we want to use a JVM that is the same as the
# java version specified in setup-java action.

DEFAULT_JVM_VERSION=8
if [ -r "${GRADLE_USER_HOME}/.wrapper/gradle.properties" ]; then
  GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
fi

APP_NAME="gradle"
APP_BASENAME=$(basename "$0")

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS=${DEFAULT_JVM_OPTS:-"-Xmx64m -Xms64m"}
# Use the maximum available, or the specified max heap size.
MAX_NATIVE_MEMORY=${MAX_NATIVE_MEMORY:-0}

# Resolve logs and install/actual installation path
APP_HOME=$(cd "${BASH_SOURCE:-$0}" && cd "$(dirname -- "${BASH_SOURCE:-$0}")" && pwd) 2>/dev/null
if [ "$APP_HOME" = "." ]; then APP_HOME=$(pwd); fi

# Make this the default maximum for Gradle
DEFAULT_JVM_MAX_HEAP_SIZE=${DEFAULT_JVM_MAX_HEAP_SIZE:-256m}
MAX_NATIVE_MEMORY=${MAX_NATIVE_MEMORY:-0}

# Path to the Gradle user's home directory
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"

if [ -z "$GRADLE_USER_HOME" ]; then
  GRADLE_USER_HOME="$HOME/.gradle"
fi

# Path to the Gradle wrapper jar
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

# If the wrapper jar is not present, download it
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Gradle wrapper jar not found, downloading..."
  wget -q "https://services.gradle.org/distributions/gradle-8.0.2-bin.zip" -O /tmp/gradle.zip
  sudo unzip -q /tmp/gradle.zip -d /opt/gradle
  /opt/gradle/gradle-8.0.2/bin/gradle wrapper --gradle-version 8.0.2 --distribution-type all
fi

exec "$APP_HOME/../gradlew" "$@"
